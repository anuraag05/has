# Copy to .env and fill in. Never commit .env (it is git-ignored).
DHAN_CLIENT_ID=your-client-id
DHAN_ACCESS_TOKEN=your-access-token

# Stocks: NIFTY50, NIFTY100, NIFTY500, or a comma list like RELIANCE,TCS,INFY
WATCHLIST=NIFTY50
# Any of: 1m,5m,15m,30m,1H,1D   (1m is heavy: keep the watchlist under ~15 stocks)
TIMEFRAMES=5m,15m,30m,1H,1D
# flip = alert when it changes to Up or Down | up | down | every
TRIGGER=flip

# Telegram (recommended): create a bot with @BotFather, then message it and open
# https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional). For Gmail use an App Password, host smtp.gmail.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
